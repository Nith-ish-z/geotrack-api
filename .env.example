# Copy to .env.local and fill in. On Vercel, set these as project env variables.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=geotracker

# Signs the app's session tokens. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Token lifetime, and how long after expiry a token can still be renewed.
JWT_EXPIRES_DAYS=7
JWT_RENEW_GRACE_DAYS=30

# Firebase service account JSON (Firebase console > Project settings > Service
# accounts > Generate new private key), pasted as one line or base64-encoded.
# Only used to send the push that asks phones for their status. Without it the
# API still works; phones then update only while the app is open.
FIREBASE_SERVICE_ACCOUNT=

# Shared secret for /api/cron/hourly. Vercel Cron sends it automatically when
# a variable with exactly this name exists.
CRON_SECRET=

# Group rules.
INVITE_CODE_TTL_SECONDS=120
GROUP_MAX_MEMBERS=6
# While a member has the app open, the rest of the group is asked for fresh
# status at most this often.
LIVE_PUSH_INTERVAL_SECONDS=30

# Login code. There is no SMS provider yet, so every phone number logs in
# with this one fixed code; see src/lib/otp.ts.
STATIC_OTP=1101
